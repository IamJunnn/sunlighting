{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunlighting",
  "compatibility_date": "2026-04-24",
  "routes": [
    { "pattern": "sun.junson.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
