# Copy to .env.local and fill in. Never commit .env.local.
# Cesium ion access token (free): https://ion.cesium.com/tokens — add Google Photorealistic 3D Tiles (asset 2275207) to your assets.
VITE_CESIUM_ION_TOKEN=
# Google Maps Platform key with "Places API (New)" enabled, restricted to your site's URL.
VITE_GOOGLE_MAPS_KEY=
